{
  "manifest_version": 3,
  "name": "Weather Report",
  "version": "3.0.1",
  "description": "Weather for any place: current conditions, air quality, hourly and 7-day forecast, plus a plain-language report for tomorrow.",
  "author": "Rajat Subhara Mondal",
  "permissions": [
    "storage",
    "geolocation"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Weather Report",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "weather-report@rajatsubharam",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "locationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
